# Google AI Studio key with image-generation billing/quota enabled.
GEMINI_API_KEY=

# Optional recurring-free fallback for the FLUX.2 storybook provider.
# Create these in Cloudflare Dashboard → Workers AI → Use REST API.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Pixazo free-preview SDXL Base 1.0 image generation.
PIXAZO_API=

# Voicebox runs locally. Keep this on loopback unless you intentionally secure it.
VOICEBOX_BASE_URL=http://127.0.0.1:17493

# Optional local scene interpretation. LM Studio/llmster runs headlessly on localhost.
LOCAL_LLM_PROVIDER=lmstudio
LMSTUDIO_BASE_URL=http://127.0.0.1:1234
LMSTUDIO_MODEL=qwen/qwen3.5-4b

# Optional override. By default, clean renders go to iCloud Drive/YoutubeShortPipeline/ready.
# YOUTUBE_SHORT_PIPELINE_ICLOUD_DIR=~/Library/Mobile Documents/com~apple~CloudDocs/YoutubeShortPipeline

PIXAZO_API = 9r3749572390471

